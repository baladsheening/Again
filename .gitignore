# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# the build spec. ignored so `git add -A` cannot publish it to a public repo by
# accident — delete this line if you want it committed deliberately
again.pdf

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# dev server output
dev.log

# vercel cli link state — written by `vercel link`, machine-specific
.vercel

# design canvas — the .dc.html artboards are the source; the seeded page is a build artifact
/design/*.html
!/design/*.dc.html
/design/zine/*.html
!/design/zine/*.dc.html
