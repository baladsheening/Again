# Neon — the pooled connection string, not the direct one.
# Neon dashboard → Connection Details → "Pooled connection".
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/again?sslmode=require"

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# TMDB. Free, from https://www.themoviedb.org/settings/api
# The "API Read Access Token" (a JWT), not the v3 API Key. It travels in an
# Authorization header rather than the query string, so it does not end up in
# request logs or Sentry breadcrumbs the way a key in a URL does.
# Server-side only — never prefix this with NEXT_PUBLIC_ (§10).
TMDB_READ_ACCESS_TOKEN=""

# Email (Phase 0.5). Resend — https://resend.com/api-keys
# Password reset is the only thing that sends. Leave the key unset in
# development: the reset link prints to the terminal running `npm run dev`,
# which is currently the only way into an account.
#
# EMAIL_FROM is optional and falls back to Resend's shared sender. That sender
# needs no domain and no DNS, and ⚠ only delivers to the address that owns the
# Resend account — enough to prove reset works on a deployment, not enough for a
# second person. Verify a domain and set this before anyone else signs up.
RESEND_API_KEY=""
EMAIL_FROM="Again <noreply@yourdomain.com>"

# Web Push (Phase 5). Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# Rate limiting (§10). Upstash Redis.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Sentry from day one (§10).
NEXT_PUBLIC_SENTRY_DSN=""
